#!/bin/bash

# --- 配置路径 ---
RES_DIR="res"
LIB_DIR="lib"
OUT_DIR="output"
SITEMAP="$OUT_DIR/sitemap.xml"
ASSETS_DIR="$OUT_DIR/assets"
RELOAD_SIGNAL="$OUT_DIR/.reload"

mkdir -p "$OUT_DIR"

# --- 编译函数 ---

# 专供 Main 编译 (HTML)
compile_main() {
	local mode=$1
	echo "[TYPST] 编译主页 -> index.html"
	typst compile "main.typ" "$OUT_DIR/index.html" --features html
	# 注入 Favicon
	[ "$mode" == "watch" ] && inject_debug_js "$OUT_DIR/index.html"
}

# 通用 HTML 编译
compile_generic() {
	local f=$1
	local mode=$2
	local out="${f%.typ}.html"
	echo "[TYPST] 编译 HTML: $f"
	typst compile "$f" "$OUT_DIR/$out" --features html

	# 注入
	[ "$mode" == "watch" ] && inject_debug_js "$OUT_DIR/$out"
}

inject_debug_js() {
	local target=$1
	perl -i -pe "s|</body>|<script src="./debug.js"></script>\n</body>|g" "$target"
}

trigger_reload() {
	date +%s >"$RELOAD_SIGNAL"
}

get_project_state() {
	# 监控当前目录的 .typ 文件
	# 监控引用的目录：LIB_DIR, RES_DIR, ASSETS_DIR
	# 使用 md5/cksum 汇总所有文件的修改时间、大小和路径
	{
		ls -lR main.typ "$LIB_DIR" "$RES_DIR" "$ASSETS_DIR" 2>/dev/null
	} | cksum
}

get_lan_ip() {
	local ip
	ip=$(perl -MIO::Socket::INET -e '
        $s = IO::Socket::INET->new(PeerAddr => "1.1.1.1", PeerPort => 80, Proto => "udp");
        print $s->sockhost if $s;
    ' 2>/dev/null)

	if [ -z "$ip" ] || [ "$ip" == "127.0.0.1" ]; then
		echo "Error: 无法获取局域网 IP，请检查网络连接。" >&2
		return 1
	fi

	echo "$ip"
}

# --- Sitemap ---
# 获取 MD5 (Bash 读文件，Perl 算哈希)
get_md5() {
	[ -f "$1" ] && cat "$1" | perl -MDigest::MD5 -e 'print Digest::MD5->new->addfile(*STDIN)->hexdigest'
}

# 自动更新 Sitemap 逻辑
sync_sitemap() {
	local index_html="$OUT_DIR/index.html"
	local hash_cache=".index.md5"

	local current_hash=$(get_md5 "$index_html")
	[ -z "$current_hash" ] && return 0 # 如果没读到内容直接退出

	# 如果哈希变了，才动 sitemap.xml
	if [ "$current_hash" != "$(cat "$hash_cache" 2>/dev/null)" ]; then
		local today=$(date +%F)

		cat >$SITEMAP <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://rzheng.xyz/</loc>
    <lastmod>$today</lastmod>
    <priority>1.0</priority>
  </url>

</urlset>
EOF
		echo "$current_hash" >"$hash_cache"
		echo "[Sitemap] 内容已更新，日期设为 $today"
	fi
}

# --- 执行逻辑 ---
case "$1" in
update)
	[ -f "main.typ" ] && compile_main "update"
	for f in *.typ; do
		if [[ "$f" != "main.typ" && "$f" != "cv.typ" ]]; then
			compile_generic "$f" "update"
		fi
	done
	sync_sitemap
	echo "[DONE] 干净的构建已完成"
	;;

watch)
	echo "[SERVER] http://localhost:3000"
	LAN_IP=$(get_lan_ip) && echo "[SERVER] http://$LAN_IP:3000"
	lsof -ti:3000 | xargs kill -9 2>/dev/null || true
	python3 -m http.server 3000 --directory $OUT_DIR >/dev/null 2>&1 &
	SERVER_PID=$!
	trap "kill $SERVER_PID; rm -f $RELOAD_SIGNAL; exit" SIGINT SIGTERM

	# 初始编译
	[ -f "main.typ" ] && compile_main "watch"
	for f in *.typ; do
		if [[ "$f" != "main.typ" && "$f" != "cv.typ" ]]; then
			compile_generic "$f" "watch"
		fi
	done
	trigger_reload

	last_state=$(get_project_state)
	while true; do
		sleep 0.8
		current_state=$(get_project_state)

		if [ "$current_state" != "$last_state" ]; then
			echo "[WATCH] 检测到变更，正在同步..."
			# 1. 只有 LIB 或 RES_DIR 变了才全量处理
			if [ -n "$(find "$LIB_DIR" "$RES_DIR" -newer "$RELOAD_SIGNAL" 2>/dev/null)" ]; then
				echo "[WATCH] 核心资源变更，全量更新..."
				[ -f "main.typ" ] && compile_main "watch"
			else
				# 2. 否则，哪行坏了修哪行 (按需编译)
				[ "main.typ" -nt "$OUT_DIR/index.html" ] && compile_main "watch"
			fi

			# 4. 触发重载并记录新状态
			trigger_reload
			last_state="$current_state"

			echo "[DONE] 所有页面已同步更新"
		fi
	done
	;;
*)
	echo "Usage: $0 {update|watch}"
	exit 1
	;;
esac
